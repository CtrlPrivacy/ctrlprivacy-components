# Lombok for every module (ctrlprivacy-build adds it as compile-only).
config.stopBubbling = true
# Generated code is marked @lombok.Generated, so Error Prone and NullAway skip it.
lombok.addLombokGeneratedAnnotation = true
# Getters follow the JavaBeans convention (getKey(), isActive()), as MapStruct, Jackson and Spring
# expect. @Value makes fields private and final, so there are no setters.
lombok.anyConstructor.addConstructorProperties = false
